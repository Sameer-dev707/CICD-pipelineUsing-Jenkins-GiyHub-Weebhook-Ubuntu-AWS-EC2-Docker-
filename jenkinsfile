pipeline {
    agent any

    environment{
        CONTAINER_NAME = "nestjs-app"
        IMAGE_NAME = "nesths-image"
        EMAIL = "msameerhassan11@gmail.com"
        port = "3000"
    } 
    stages {
        stage ("clone Repo") {
            steps {
                git branch: 'main', url: 'https://github.com/Sameer-dev707/CICD-pipelineUsing-Jenkins-GiyHub-Weebhook-Ubuntu-AWS-EC2-Docker-.git'
            }
        }
        stage ('Build Docker Image') {
            steps {
                sh 'docker build -t IMAGE_NAME '
            }
        } 
        stage ('Stop & Remove Previos Container') {
            steps {
                sh '''
                docker stop $CONTAINER_NAME || 
                true 
                docker rm $CONTAINER_NAME || true 

                '''
            }
        } 
        stage ('Docker Container Run') {
            steps {
                sh '''
               docker run -d -p ${port}:${PORT}
               --name $CONTAINER_NAME $IMAGE_NAME

                '''
            }
        } 
         stage ('Send Email Notification') {
            steps {
                sh '''
               emailtext(
               subject: "nestJS app Deployed successfully on EC2"
               body: "Your Nest JS app is Deployed!"
               to: "${EMAIL}" 
               )

                '''
            }
        } 
    }
}